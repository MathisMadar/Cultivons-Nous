{
  "rules": {
    "Cultivons-26-2dkwq0": {
      ".read": true,
      "jours": {
        "$date": {
          "question": {
            ".write": "!data.exists()"
          },
          "A": {
            ".write": "!data.exists()",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
          },
          "B": {
            ".write": "!data.exists()",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
          }
        }
      },
      "utilisees": {
        "$id": {
          ".write": "!data.exists()",
          ".validate": "newData.val() === true"
        }
      },
      "tokens": {
        "$user": {
          ".write": "$user === 'A' || $user === 'B'",
          ".validate": "newData.isString()"
        }
      }
    }
  }
}
